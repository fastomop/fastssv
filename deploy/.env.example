# FastSSV deploy-time configuration.
#
# Copy this file to `deploy/.env` (or the repo root, picked up by docker compose)
# and override values as needed. All variables have sane defaults baked into
# `deploy/docker-compose.yml`, so this file is purely for convenience and
# documentation — empty values fall back to those defaults.
#
# Usage:
#   cp deploy/.env.example deploy/.env
#   # edit deploy/.env
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up

# -----------------------------------------------------------------------------
# Compose / runtime
# -----------------------------------------------------------------------------

# Host port the API is published on. Container always listens on 8000.
FASTSSV_PORT=8000

# Number of gunicorn worker processes. Tune for the deploy box: typical guidance
# is `2 * CPU + 1`. Each worker holds the rule registry in memory (~10 MB).
WEB_CONCURRENCY=2

# Container resource ceilings (cgroup limits enforced by the kernel). Scale
# with WEB_CONCURRENCY; defaults suit the 2-worker configuration.
FASTSSV_MEM_LIMIT=1g
FASTSSV_CPUS=2.0

# -----------------------------------------------------------------------------
# API behavior (read by `fastssv.api.config.Settings`, prefix FASTSSV_API_)
# -----------------------------------------------------------------------------

# Log level for the FastAPI app. One of DEBUG / INFO / WARNING / ERROR / CRITICAL.
FASTSSV_API_LOG_LEVEL=INFO

# Per-IP rate limit applied by slowapi to /v1/validate. Format: "<count>/<window>".
# Examples: "60/minute", "1000/hour", "10/second".
FASTSSV_API_RATE_LIMIT=60/minute

# Rate-limit storage backend. Empty (the default) uses in-memory storage,
# which is PER-PROCESS: with N gunicorn workers the effective limit is
# N x FASTSSV_API_RATE_LIMIT and counters reset on restart. Point at a
# shared backend for a real cross-worker limit.
# Example: FASTSSV_API_RATE_LIMIT_STORAGE_URI=redis://redis:6379
FASTSSV_API_RATE_LIMIT_STORAGE_URI=

# Max bytes accepted for a single SQL submission. Requests exceeding this are
# rejected with HTTP 413 by the body-size middleware before parsing.
FASTSSV_API_MAX_SQL_BYTES=100000

# Wall-clock timeout for validating a single submission. Fractional seconds
# allowed. The client gets HTTP 408; note the CPU-bound parse itself cannot
# be cancelled and runs to completion on its worker thread — the concurrency
# bound below is what protects the thread pool.
FASTSSV_API_PARSE_TIMEOUT_SECONDS=5

# Max validations running concurrently per worker process. When saturated the
# API fails fast with HTTP 503 instead of queueing onto pinned threads.
FASTSSV_API_MAX_CONCURRENT_VALIDATIONS=8

# Comma-separated list of allowed CORS origins for the JSON API.
# Empty (the default) means no cross-origin browser requests are accepted.
# For the HTMX UI served by the same app, same-origin requests work without CORS.
# Example: FASTSSV_API_CORS_ORIGINS=https://example.com,https://staging.example.com
FASTSSV_API_CORS_ORIGINS=

# Trust X-Forwarded-* headers from a reverse proxy (e.g. nginx, Traefik, Caddy)
# in front of the container. Enable when terminating TLS upstream so generated
# URLs reflect the external https scheme/host. Disable if exposing the
# container directly to clients. The compose file defaults this to "true";
# the in-code default (when running outside compose) is "false".
FASTSSV_API_BEHIND_PROXY=false

# Which peers' X-Forwarded-* headers to trust when BEHIND_PROXY=true.
# Comma-separated IPs/CIDRs, or "*" for any peer. Keep "*" ONLY if the app
# is reachable exclusively through the proxy — otherwise a direct client
# can spoof its IP (and rotate rate-limit buckets) via X-Forwarded-For.
# Example: FASTSSV_API_TRUSTED_PROXY_HOSTS=10.0.0.0/8
FASTSSV_API_TRUSTED_PROXY_HOSTS=*

# -----------------------------------------------------------------------------
# MCP (Model Context Protocol) Streamable HTTP endpoint at /mcp
# -----------------------------------------------------------------------------
# Spec: https://modelcontextprotocol.io/specification/2025-11-25/basic/transports
#
# Authentication: the MCP endpoint is intentionally unauthenticated at the
# application layer — gate it at your reverse proxy (oauth2-proxy, mTLS,
# network ACLs, Cloudflare Access, ...). Auth is OPTIONAL per the MCP spec.

# Enable the /mcp mount. Requires the [mcp] extra to be installed.
FASTSSV_API_MCP_ENABLED=false

# Comma-separated allowlist of Origins permitted to hit /mcp from a browser.
# Spec MUST: servers validate the Origin header to prevent DNS rebinding
# attacks. Requests without an Origin header (curl, Claude Desktop, MCP
# Inspector running outside a browser) are always allowed. Requests with
# a present-but-unlisted Origin are rejected with 403.
# Example: FASTSSV_API_MCP_ALLOWED_ORIGINS=https://chat.example.com
FASTSSV_API_MCP_ALLOWED_ORIGINS=
